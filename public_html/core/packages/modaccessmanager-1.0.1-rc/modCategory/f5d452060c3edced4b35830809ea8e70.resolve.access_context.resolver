<?php
/**
 * Resolve creating policies
 *
 * @var xPDOObject $object
 * @var array $options
 */

if ($object->xpdo) {
	/* @var modX $modx */
	$modx =& $object->xpdo;

	switch ($options[xPDOTransport::PACKAGE_ACTION]) {
		case xPDOTransport::ACTION_INSTALL:
		case xPDOTransport::ACTION_UPGRADE:

            $policy_id = $modx->getObject('modAccessPolicy', array('name' => 'Context'))->get('id');

            $data = array(
                array(
                    'target' => 'mgr',
                    'principal_class' => 'modUserGroup',
                    'principal' => BUILD_PARAMS_USER_GROUP,
                    'authority' => BUILD_PARAMS_ROLE_MANAGER,
                    'policy'    => BUILD_PARAMS_POLICY_ID,
                ),
                array(
                    'target' => 'web',
                    'principal_class' => 'modUserGroup',
                    'principal' => BUILD_PARAMS_USER_GROUP,
                    'authority' => BUILD_PARAMS_ROLE_MANAGER,
                    'policy' => BUILD_PARAMS_POLICY_ID,
                ),
                array(
                    'target' => 'web',
                    'principal_class' => 'modUserGroup',
                    'principal' => BUILD_PARAMS_USER_GROUP,
                    'authority' => 9999,
                    'policy' => $policy_id,
                ),
            );

            /* search policy access */
            $c = $modx->newQuery('modAccessPolicy');
            $c->where(array('lexicon:!=' => 'permissions'));
            if($objectList = $modx->getCollection('modAccessPolicy', $c)){
                foreach ($objectList as $object) {

                    $id = $object->get('id');
                    $data[] = array(
                        'target' => 'mgr',
                        'principal_class' => 'modUserGroup',
                        'principal' => BUILD_PARAMS_USER_GROUP,
                        'authority' => BUILD_PARAMS_ROLE_MANAGER,
                        'policy' => $id,
                    );

                }
            }

            foreach ($data as $key => $row) {
                if(!$tmp = $modx->getObject('modAccessContext', $row)){
                    $tmp = $modx->newObject('modAccessContext');
                    $tmp->fromArray($row);
                    $tmp->save();
                }
            }

			break;
	}
}
return true;