<div class="js-rvg-gallery rvg-gallery" data-auto-play="[[+autoPlay]]" data-tpl-embed="[[+tplEmbed]]" data-tpl-tag="[[+tplTag]]" >
    <div class="js-rvg-holder rvg-gallery-holder">
        [[+rows]]
    </div>
    <div class="rvg-text-center" style="[[+isMore:isnot=`1`:then=`display:none;`]]">
        <a href="#" class="js-rvg-more rvg-btn rvg-btn-more" data-params='[[+params]]'>More video</a>
    </div>
</div>